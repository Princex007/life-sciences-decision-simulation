        {
          "variable": "market_share",
          "operation": "add",
          "value": "0.025 * payer_access * physician_adoption * patient_adherence_rate * 10 * (1 + efficacy_advantage) * min(1.25, competitor_price / max(drug_price, 1)) * max(0.65, 1 - (competitor_promotion - 1) * 0.08)",
          "minimum": 0.0,
          "maximum": 0.8
        },
        {
          "variable": "competitor_market_share",
          "operation": "add",
          "value": "-0.45 * 0.025 * payer_access * physician_adoption * patient_adherence_rate * 10 * (1 + efficacy_advantage) * min(1.25, competitor_price / max(drug_price, 1)) * max(0.65, 1 - (competitor_promotion - 1) * 0.08)",
          "minimum": 0.05,
          "maximum": 0.8
        },
        {
          "variable": "physician_adoption",
          "operation": "add",
          "value": "0.015 * payer_access",
          "minimum": null,
          "maximum": 0.95
        },
        {
          "variable": "patient_adoption",
          "operation": "add",
          "value": "0.01 * payer_access",
          "minimum": null,
          "maximum": 0.95
        }
      ]
