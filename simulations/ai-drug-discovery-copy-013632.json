  "evaluation_objectives": {
    "company": {
      "label": "Illustrative discovery-portfolio score balancing candidate throughput against configured discovery cost. Not calibrated evidence of value creation.",
      "normalization_assumption": "discovery_candidates uses an illustrative 0 to 80 count range; rd_cost_index uses an illustrative 40 to 200 index range.",
      "limitations": "Both components are synthetic illustrative proxies. The score expresses a configured preference, not an empirically validated objective.",
      "score_tie_tolerance": 0.005,
      "score_tie_tolerance_label": "Experimental, illustrative, and uncalibrated score-margin tolerance.",
      "components": [
        {
          "name": "candidate_throughput",
          "source": "projected_state",
          "metric": "discovery_candidates",
          "normalization": {
            "method": "min_max",
            "minimum": 0,
            "maximum": 80,
            "basis": "illustrative candidate-count ceiling"
          },
          "preference": "maximize",
          "weight": 0.6
        },
        {
          "name": "discovery_cost",
          "source": "projected_state",
          "metric": "rd_cost_index",
          "normalization": {
            "method": "min_max",
            "minimum": 40,
            "maximum": 200,
            "basis": "illustrative cost-index range"
          },
          "preference": "minimize",
          "weight": 0.4
        }
      ]
    },
    "competitor": {
      "label": "Illustrative competitor score balancing programme speed against configured competitive position. Not calibrated evidence.",
      "normalization_assumption": "competitor_pipeline_years uses an illustrative 1 to 6 year range; competitive_intensity uses its configured 0 to 1 bounds.",
      "limitations": "Both components are synthetic illustrative proxies.",
      "score_tie_tolerance": 0.005,
      "score_tie_tolerance_label": "Experimental, illustrative, and uncalibrated score-margin tolerance.",
      "components": [
        {
          "name": "programme_speed",
          "source": "projected_state",
          "metric": "competitor_pipeline_years",
          "normalization": {
            "method": "min_max",
            "minimum": 1,
            "maximum": 6,
            "basis": "illustrative programme-length range"
          },
          "preference": "minimize",
          "weight": 0.6
        },
        {
          "name": "competitive_position",
          "source": "projected_state",
          "metric": "competitive_intensity",
          "normalization": {
            "method": "min_max",
            "minimum": 0,
            "maximum": 1,
            "basis": "configured competitive_intensity bounds"
          },
          "preference": "maximize",
          "weight": 0.4
        }
      ]
    }
  },
